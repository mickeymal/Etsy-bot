# ── Telegram ──────────────────────────────────────────────────────────────────
# 1. Open Telegram and message @BotFather
# 2. Send /newbot  →  follow prompts  →  copy the token below
TELEGRAM_BOT_TOKEN=your-bot-token-here

# Your personal chat ID or a group chat ID.
# Easiest way to find it:
#   a) Message your bot once
#   b) Open: https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
#   c) Copy the "id" value from the "chat" object
TELEGRAM_CHAT_ID=your-chat-id-here

# ── Signal tuning (optional) ──────────────────────────────────────────────────
# Minimum confidence percentage before a signal is sent (default 60)
# Lower = more signals (noisier). Higher = fewer, stronger signals.
SIGNAL_THRESHOLD=60
